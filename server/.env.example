# Copy to .env and fill in. .env is gitignored; process env always wins.

# --- Privy auth (live mode when app id + secret are set)
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: static SPKI verification key from the dashboard (skips JWKS fetch)
# PRIVY_VERIFICATION_KEY=

# --- Hosted Qwen (OpenAI-compatible); scripted fallback when unset
# QWEN_BASE_URL=http://127.0.0.1:6402/v1
# QWEN_MODEL=qwen3.8-27b
# QWEN_API_KEY=

# --- Stellar rail
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# STELLAR_POOL_ACCOUNT=
# STELLAR_USDC_ISSUER=
# STELLAR_POLL_MS=30000

# --- KripiCard (mock provider when unset)
# KRIPICARD_API_KEY=
# KRIPICARD_BANK_BIN=

# --- Ops
# PORT=8787
# CORS_ORIGIN=*
# RATE_LIMIT_MAX=120
